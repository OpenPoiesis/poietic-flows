        },
        {
          "inlineContent" : [
            {
              "text" : "The interpolated y-value at parameter t",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    },
    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The Catmull-Rom spline is a cubic interpolation method that creates smooth",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "C¹-continuous curves passing through control points. This function evaluates",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "a single segment of the spline using four control points.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Formula",
          "level" : 2,
          "text" : "Formula",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "For a segment between P₁ and P₂, with neighboring control points P₀ and P₃:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "P(t) = 0.5 × [(2P₁) +",
            "              (-P₀ + P₂)t +",
            "              (2P₀ - 5P₁ + 4P₂ - P₃)t² +",
            "              (-P₀ + 3P₁ - 3P₂ + P₃)t³]"
          ],
          "syntax" : null,
          "type" : "codeListing"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Parameters",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "p0: The control point before the segment (affects the tangent at p1)",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "p1: The start point of the segment",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "p2: The end point of the segment",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "p3: The control point after the segment (affects the tangent at p2)",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "t: The parameter value in the range [0, 1], where 0 corresponds to p1 and 1 to p2",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    }
                  ],
                  "type" : "unorderedList"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "This function only interpolates the y-coordinates. The caller is",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "responsible for determining the appropriate t value based on x-coordinates.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
