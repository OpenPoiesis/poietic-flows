      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "You can use simulation result view for simple printing of the simulation results.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 3,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let plan: SimulationPlan     \/\/ Assume this exists.",
            "let result: SimulationResult \/\/ Assume this exists.",
            "",
            "let view = SimulationResultView(result: result, plan: plan,",
            "                                columns: [\"time\"] + plan.objectNames)",
            "",
            "print(view.columnNames.joined(separator: \"\\t\"))",
            "for row in view {",
            "    print(row.stringValues().joined(separator: \"\\t\"))",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "This is not suitable for a CSV output. Please use ",
                  "type" : "text"
                },
                {
                  "code" : "CSVFormatter",
                  "type" : "codeVoice"
                },
                {
                  "text" : " from PoieticCore.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
