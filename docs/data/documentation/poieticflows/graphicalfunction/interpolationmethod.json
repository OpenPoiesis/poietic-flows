    },
    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The interpolation method determines how the function computes output values",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "for input x-coordinates that fall between defined control points. Different",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "methods provide different trade-offs between smoothness, computational cost,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "and behavioural characteristics.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Step",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".step",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Left-continuous step function, also known as zero-order hold. The",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "function maintains a constant value from each control point until reaching the next",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "control point.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Linear",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".linear",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Point-wise linear interpolation between consecutive control points.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Creates straight line segments connecting each pair of adjacent points.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Cubic",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".cubic",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Catmull-Rom spline interpolation producing smooth curves that pass",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "through all control points. Uses four points (two neighbours on each side) to compute",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "a cubic polynomial for each segment.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Nearest Step",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".nearestStep",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Nearest-neighbor interpolation. Returns the y-value of",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "whichever control point has the closest x-coordinate to the query point.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Choosing-an-Interpolation-Method",
          "level" : 2,
          "text" : "Choosing an Interpolation Method",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Use ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "step",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " for discrete state machines, digital signals, or piecewise-constant functions",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Use ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "linear",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " as the general-purpose default for most modelling scenarios",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Use ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "cubic",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " when smoothness matters (e.g., animation, natural phenomena)",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Use ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "nearestStep",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " for classification or when exact point values matter",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        }
      ],
      "kind" : "content"
