  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The object that performs the simulation is ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/StockFlowSimulation",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ". It reads the simulation plan",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "and evaluates simulation objects according to specified order.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Simulation-System",
          "level" : 3,
          "text" : "Simulation System",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "In your application you run the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/StockFlowSimulationSystem",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " within a schedule. You rarely need to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "use the simulation object directly. The system does the following:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Reads the ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationSettings",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " singleton to set-up time, time delta and solver type. If not",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "present, then default settings are used.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Reads the ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/ScenarioParameters",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " that is used to override object values during initialisation.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Initialises a new simulation state.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Runs the simulation for given number of steps.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Constructs a simulation result ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationResult",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " and sets it as a singleton.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "If the simulation was not successful, the simulation result is not set and if existed before the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "system was run, it will be removed.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Computation",
          "level" : 2,
          "text" : "Computation",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The simulation is performed as follows:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "inlineContent" : [
                {
                  "text" : "Initialisation",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "prepare new simulation state",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "set values of builtins in the state",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "FOR EACH simulation object in the order of computational dependency:",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Stocks",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ", ",
                              "type" : "text"
                            },
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Auxiliaries",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ", ",
                              "type" : "text"
                            },
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Flow Rates",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ": compute initial value by evaluating the formula.",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Graphical function",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ": get initial value according to the function definition.",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Delay",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ", ",
                              "type" : "text"
                            },
                            {
                              "inlineContent" : [
                                {
                                  "text" : "Smooth",
                                  "type" : "text"
                                }
                              ],
                              "type" : "emphasis"
                            },
                            {
                              "text" : ": If the object has initial value is set, initialise it to the value,",
                              "type" : "text"
                            },
                            {
                              "text" : " ",
                              "type" : "text"
                            },
                            {
                              "text" : "otherwise use value from the parameter.",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    }
                  ],
                  "type" : "unorderedList"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "inlineContent" : [
            {
              "inlineContent" : [
                {
                  "text" : "Simulation Step: Euler Integration",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Prepare a new simulation state.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Get stock values from the t-1 (previous step).",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Get flows estimation from the t-1 (previous step).",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Compute adjusted flows from flows estimates and stock values.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "FOR each stock:",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        },
                        {
                          "items" : [
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "total inflow estimate = ∑ flow rates filling the stock",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                }
                              ]
                            },
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "total outflow estimate = ∑ flow rates draining the stock",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                }
                              ]
                            },
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "Compute adjusted flows by scaling:",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                },
                                {
                                  "items" : [
                                    {
                                      "content" : [
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "IF flow scaling is ",
                                              "type" : "text"
                                            },
                                            {
                                              "inlineContent" : [
                                                {
                                                  "text" : "outflows first",
                                                  "type" : "text"
                                                }
                                              ],
                                              "type" : "emphasis"
                                            },
                                            {
                                              "text" : ":",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        },
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "scale = min(1, current \/ outflow)",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        },
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "adjustedₙ = estimatedₙ * scale",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        }
                                      ]
                                    },
                                    {
                                      "content" : [
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "IF flow scaling is ",
                                              "type" : "text"
                                            },
                                            {
                                              "inlineContent" : [
                                                {
                                                  "text" : "inflows first",
                                                  "type" : "text"
                                                }
                                              ],
                                              "type" : "emphasis"
                                            },
                                            {
                                              "text" : ":",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        },
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "available = current stock + inflow",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        },
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "scale = min(1, available \/ outflow)",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        },
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "adjustedₙ = estimatedₙ * scale",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        }
                                      ]
                                    }
                                  ],
                                  "type" : "unorderedList"
                                }
                              ]
                            }
                          ],
                          "type" : "orderedList"
                        }
                      ]
                    }
                  ],
                  "type" : "orderedList"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Returns a vector of adjusted flow rates.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Compute derivatives Δstock from adjusted flows and stocks.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "FOR each stock:",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        },
                        {
                          "items" : [
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "inflow = total ∑ of adjusted stock’s inflows",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                }
                              ]
                            },
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "outflow = total ∑ of adjusted stock’s outflows",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                }
                              ]
                            },
                            {
                              "content" : [
                                {
                                  "inlineContent" : [
                                    {
                                      "text" : "compute net flow:",
                                      "type" : "text"
                                    }
                                  ],
                                  "type" : "paragraph"
                                },
                                {
                                  "items" : [
                                    {
                                      "content" : [
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "IF allows negative: net flow = (inflow - outflow) * timeDelta",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        }
                                      ]
                                    },
                                    {
                                      "content" : [
                                        {
                                          "inlineContent" : [
                                            {
                                              "text" : "ELSE: net flow = max(-current, (inflow - outflow) * timeDelta)",
                                              "type" : "text"
                                            }
                                          ],
                                          "type" : "paragraph"
                                        }
                                      ]
                                    }
                                  ],
                                  "type" : "unorderedList"
                                }
                              ]
                            }
                          ],
                          "type" : "orderedList"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "Returns a vector of Δstock",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    }
                  ],
                  "type" : "orderedList"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Adjust stocks: stockₙ(t) = stockₙ(t-1) + Δstockₙ",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Update auxiliaries and flow rates.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Write adjusted flow values to the simulation state.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "Runge Kutta 4 solver (",
                  "type" : "text"
                },
                {
                  "code" : "rk4",
                  "type" : "codeVoice"
                },
                {
                  "text" : ") follows the same pattern with four intermediate evaluations.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Note",
          "style" : "note",
          "type" : "aside"
        },
        {
          "anchor" : "Results",
          "level" : 2,
          "text" : "Results",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/StockFlowSimulationSystem",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " runs the simulation and if the simulation was successful",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "(no evaluation errors), then it produces a ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationResult",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " singleton. The result contains",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "states for each step of the simulation.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The results can be further processed and distributed on entities for presentation.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
