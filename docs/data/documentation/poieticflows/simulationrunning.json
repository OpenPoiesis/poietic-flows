      "type" : "text"
    },
    {
      "text" : "are evaluated, how the computation is performed and where in the simulation state the variables",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "live.",
      "type" : "text"
    }
  ],
