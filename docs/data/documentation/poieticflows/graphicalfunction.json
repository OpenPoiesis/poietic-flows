    },
    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "code" : "GraphicalFunction",
              "type" : "codeVoice"
            },
            {
              "text" : " represents a mathematical function y = f(x) defined by",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "discrete control points rather than an analytical formula. The function value",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "at any x-coordinate is computed by interpolating between the control points",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "using one of several interpolation methods.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Graphical functions are commonly used in system dynamics modelling to represent",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "non-linear relationships, lookup tables, and empirical data. They provide a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "flexible way to define complex relationships without requiring explicit",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "mathematical formulas.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Create a graphical function by specifying control points and an interpolation method:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "let points = [",
            "    Point(x: 0.0, y: 0.0),",
            "    Point(x: 5.0, y: 10.0),",
            "    Point(x: 10.0, y: 15.0)",
            "]",
            "",
            "let function = GraphicalFunction(points: points, method: .linear)",
            "let result = function.apply(x: 7.5)  \/\/ Returns 12.5"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "anchor" : "Interpolation-Methods",
          "level" : 2,
          "text" : "Interpolation Methods",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Four interpolation methods are available, each suited for different use cases:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Step",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".step",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Left-continuous step function (zero-order hold).",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Best for discrete state changes and digital signals.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Linear",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".linear",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Piecewise linear interpolation.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "General-purpose method providing simple, predictable behaviors.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Cubic",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".cubic",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Smooth Catmull-Rom spline interpolation.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Creates smooth curves through all points, ideal for natural-looking curves.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Nearest",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "code" : ".nearestStep",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : "): Nearest-neighbor interpolation.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Selects the y-value of the closest control point.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "See ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/GraphicalFunction\/InterpolationMethod",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " for detailed descriptions of each method.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Notes-on-Points",
          "level" : 2,
          "text" : "Notes on Points",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Control points are automatically sorted by their x-coordinate when the function",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "is created, ensuring correct interpolation behaviour regardless of input order.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Points outside the defined range are clamped to the boundary values (except",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "for nearest-neighbor interpolation, which extends the nearest point indefinitely).",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Performance-Considerations",
          "level" : 2,
          "text" : "Performance Considerations",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Point lookup is O(n) where n is the number of points",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Consider using fewer points for frequently evaluated functions",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Points are sorted once during initialisation",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/GraphicalFunction\/InterpolationMethod",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
                  "text" : ", ",
