        },
        {
          "inlineContent" : [
            {
              "text" : "The computational dependency means, that the objects are ordered so that objects that do",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "not require other objects to be computed, such as constants are at the beginning. The",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "objects that depend on others by using them as a parameter follow the variables they depend",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "on.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Computing objects in this order assures that we have all the parameters computed when",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "they are needed.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The order is computed by the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/ComputationOrderSystem",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " and then filled with details in the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationPlanningSystem",
              "isActive" : true,
              "type" : "reference"
            },
            {
