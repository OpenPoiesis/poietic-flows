        },
        {
          "inlineContent" : [
            {
              "text" : "The list of state variables defines the state vector layout and content.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Simulation object’s state might be contained in multiple state variables. For example, delay",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "uses two state variables: list of double values for the queue and an initial value.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The internal state is typically not to be presented to the user.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
