          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "After updating the world using the system, one can remove and create parameter edges",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "as follows:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "\/\/ Assume the world and trans are given as:",
            "let world: World",
            "let trans: TransientPlane",
            "",
            "let proposal: ParameterProposal = world.singleton()!",
            "",
            "for id in proposal.toRemove {",
            "    trans.removeCascading(id)",
            "}",
            "for edgeProposal in proposal.toAdd {",
            "    trans.createEdge(.Parameter,",
            "                     origin: edgeProposal.origin,",
            "                     target: edgeProposal.target)",
            "}"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        }
      ],
