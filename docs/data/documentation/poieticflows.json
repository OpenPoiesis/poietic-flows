      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "inlineContent" : [
                {
                  "text" : "Stock and Flow",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : " models are networks of stocks that accumulate material (or energy, value,…),",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "flows that move the material, and of other meaningful connections.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "See ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/en.wikipedia.org\/wiki\/Stock_and_flow",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This is a methodology package, not a tool nor an application. This package is for developers",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "that want to build applications presenting Stock and Flow scenarios or to build tools for modellers.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Features",
          "level" : 3,
          "text" : "Features",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Metamodel",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : ": Stock, FlowRate, Auxiliary, GraphicalFunction, Delay, Smooth and related",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "edges. See ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/Metamodel",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " with full list of nodes and edges with their description.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Planning Pipeline",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : ": Collection of systems that analyse the design and turn it into a",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "computable ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationPlan",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ". See ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/PlanAndPlanning",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Simulation",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : ": ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "https:\/\/en.wikipedia.org\/wiki\/Euler_method",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "https:\/\/en.wikipedia.org\/wiki\/Runge–Kutta_methods",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " solvers, support for",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "non-negative stock constraints. See ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticFlows\/documentation\/PoieticFlows\/SimulationRunning",
